// ═══════════════════════════════════════════════════════════════════════
//  schema "chat" — แชทองค์กรแบบ LINE: ข้อความ, ตอบกลับ, อีโมจิ, @แท็ก, อ่านแล้ว,
//  รูป/ไฟล์/เสียง — ส่งสดผ่าน SSE (/api/realtime) ไม่ต้องโพล
//
//  ต่างจาก report_task.stores (ก้อน JSON เดียวต่อบริษัท) โดยตั้งใจ — แชทมีแนวโน้ม
//  มีข้อความหลักพันแถวต่อบริษัท ต้องแบ่งหน้า/query เป็นแถวจริงตั้งแต่แรก ไม่ใช่โหลด
//  ทั้งก้อนทุกครั้ง ตารางต่อ entity แบบเดียวกับ ReportTask (report_task.prisma)
// ═══════════════════════════════════════════════════════════════════════

/// ห้องแชท — DM (2 คน), กลุ่ม, หรือห้องรวมทั้งบริษัท (type="org", สร้างครั้งเดียวต่อบริษัท)
model ChatChannel {
  orgId String @map("org_id")
  id    String @id @default(uuid())

  /// "dm" | "group" | "org"
  type        String
  /// ไม่มีค่าสำหรับ DM — ฝั่ง client ต่อชื่อจากสมาชิกเอง
  name        String?
  /// รูปกลุ่ม / รูปห้องรวมทั้งบริษัท (แอดมินของห้องตั้งเอง) — null = ไอคอนเดิม · DM ใช้รูปของอีกฝั่ง
  avatarUrl   String?  @map("avatar_url")
  createdById String   @map("created_by_id")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  /// กลุ่มประจำแผนก (สร้าง/ซิงก์สมาชิกอัตโนมัติจาก core.users.department_id —
  /// ดู syncDepartmentChannels) null = กลุ่มที่คนสร้างเอง
  departmentId String? @map("department_id")
  /// ข้อความที่ปักเป็น "ประกาศ" ไว้บนหัวห้อง (แบบ LINE) — ไม่ใช่ FK เพราะ
  /// ข้อความถูก soft-delete ได้ ฝั่งอ่านเช็ค deletedAt เอง
  announcementId String? @map("announcement_id")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ChatChannelMember[]
  messages     ChatMessage[]
  readStates   ChatReadState[]
  albums       ChatAlbum[]
  notes        ChatNote[]

  @@unique([orgId, departmentId])
  @@index([orgId, type])
  @@map("channels")
  @@schema("chat")
}

/// สมาชิกของห้อง "dm"/"group" เท่านั้น — ห้อง "org" ไม่มีแถวในตารางนี้เลย
/// (ดูคอมเมนต์ยาวใน ChatReadState ว่าทำไม) คุมแค่ "ใครเข้าห้องนี้ได้บ้าง" ล้วน ๆ
/// ไม่ปนกับสถานะอ่าน/ยังไม่อ่านอีกต่อไป (ย้ายไป ChatReadState)
model ChatChannelMember {
  channelId String @map("channel_id")
  userId    String @map("user_id")
  /// สำเนา orgId ไว้ query ตรง ๆ โดยไม่ต้อง join channel (เช่น "ห้องทั้งหมดของคนนี้")
  orgId String @map("org_id")

  joinedAt DateTime @default(now()) @map("joined_at")
  /// เลิกใช้ — ปิดเสียงย้ายไป ChatReadState.muted (ห้อง org ไม่มีแถวในตารางนี้)
  muted    Boolean  @default(false)
  /// "admin" | "member" — แอดมินกลุ่มเปลี่ยนชื่อ/เพิ่ม-ลบสมาชิก/ปักประกาศได้
  role     String   @default("member")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([orgId, userId])
  @@map("channel_members")
  @@schema("chat")
}

/// สถานะ "อ่านถึงข้อความไหนแล้ว" ต่อคนต่อห้อง — แยกออกจาก ChatChannelMember โดย
/// ตั้งใจ เพราะห้อง org (ทุกคนในบริษัทเข้าได้โดยปริยาย) ไม่มีแถว membership เลย
/// ถ้ายังผูก lastReadAt ไว้กับ membership เหมือนเดิม จะต้อง insert
/// ChatChannelMember ให้พนักงานทุกคนตอนสร้างห้อง org — ห้องเดียวแต่เขียนเป็น
/// พันแถวโดยไม่จำเป็น (พนักงานเยอะ = แพงขึ้นเรื่อย ๆ ทั้งที่ไม่มีใครอ่านเลยก็ได้)
///
/// ที่นี่แถวเกิดแบบ lazy (upsert) เฉพาะตอน user เปิดห้องนั้นจริง ๆ ครั้งแรก —
/// ห้อง org ที่ไม่มีใครเปิดอ่านเลยไม่มีแถวในตารางนี้แม้แต่แถวเดียว ใช้ตารางเดียว
/// กับทุกประเภทห้อง (org/dm/group) ไม่แยกลอจิกตามประเภท
model ChatReadState {
  channelId String @map("channel_id")
  userId    String @map("user_id")
  orgId     String @map("org_id")

  /// เทียบกับ ChatMessage.seq (ไม่ใช่ createdAt — ดูเหตุผลที่ ChatMessage.seq)
  lastReadSeq BigInt?   @map("last_read_seq")
  lastReadAt  DateTime? @map("last_read_at")
  /// ตั้งค่าส่วนตัวต่อห้อง — อยู่ที่นี่ไม่ใช่ ChatChannelMember เพราะห้อง org
  /// ไม่มีแถว membership (เหตุผลเดียวกับสถานะอ่าน)
  pinned Boolean @default(false)
  muted  Boolean @default(false)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([orgId, userId])
  @@map("read_states")
  @@schema("chat")
}

/// ข้อความในห้อง — เนื้อความ + ไฟล์แนบ (มาจาก /api/chat/uploads ซึ่งใช้ putFile
/// ตัวเดียวกับที่ report_task ใช้อัปโหลดรูป — ไม่มีระบบเก็บไฟล์ใหม่)
model ChatMessage {
  orgId     String @map("org_id")
  id        String @id @default(uuid())
  /// ตัวนับเรียงแทรกจริง ใช้เป็น cursor ตอนโพลข้อความใหม่ (?after=<seq>) —
  /// createdAt เทียบ ">" ไม่ได้ปลอดภัยพอ (สองข้อความ insert ใน millisecond
  /// เดียวกันชนกันได้ ทำให้โพลรอบถัดมาข้ามหรือได้ซ้ำ) ส่วน id เป็น uuid สุ่ม
  /// เรียงลำดับไม่ได้เลย seq เป็น bigserial การันตี monotonic + unique ต่อการ
  /// insert เป๊ะ ๆ และ index แคบกว่า timestamp ด้วย
  seq       BigInt @default(autoincrement())
  channelId String @map("channel_id")
  authorId  String @map("author_id")

  /// "text" | "system" (เช่น "สมชายเพิ่มนภาเข้ากลุ่ม")
  kind String  @default("text")
  body String?
  /// [{ url, name, mime, size, kind, thumbUrl?, width?, height?, durationMs? }]
  /// kind: "image" | "file" | "audio" | "video"
  attachments Json      @default("[]")
  /// ข้อความที่ตอบกลับ (quote) — ไม่ใช่ FK เพราะต้นทางถูกยกเลิกได้
  replyToId   String?   @map("reply_to_id")
  /// userId ที่ถูก @แท็ก ("all" = ทุกคนในห้อง)
  mentions    String[]  @default([])
  /// รหัสที่เครื่องผู้ส่งสร้างเอง — ส่งซ้ำตอนเน็ตแย่แล้วได้ข้อความเดิม ไม่เด้งซ้ำ
  clientId    String?   @map("client_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel   ChatChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions ChatReaction[]

  @@unique([channelId, authorId, clientId])
  @@index([channelId, seq])
  @@index([orgId])
  @@map("messages")
  @@schema("chat")
}

/// อีโมจิที่กดให้ข้อความ — คนละอีโมจิได้หลายอัน กดซ้ำ = เอาออก
model ChatReaction {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("reactions")
  @@schema("chat")
}

/// ทุกไฟล์ที่อัปขึ้นแชท — ใช้นับพื้นที่รวมเข้าเพดานบริษัท (company-files/lib/quota)
/// และเป็นฐานของการลบไฟล์หมดอายุในอนาคต url = `/api/files/<orgId>/chat/...`
model ChatFile {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  uploadedById String   @map("uploaded_by_id")
  url          String   @unique
  size         Int
  mime         String
  kind         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("files")
  @@schema("chat")
}

/// อัลบั้มของห้อง (แบบ LINE) — รูป/วิดีโอในแชทหมดอายุเมื่อครบกำหนด (ดู modules/chat/lib/retention.ts)
/// ยกเว้นที่ถูกบันทึกลงอัลบั้ม ⇒ อยากเก็บรูปไหนไว้ถาวร ใส่อัลบั้ม
model ChatAlbum {
  orgId       String   @map("org_id")
  id          String   @id @default(uuid())
  channelId   String   @map("channel_id")
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel ChatChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   ChatAlbumItem[]

  @@index([orgId, channelId])
  @@map("albums")
  @@schema("chat")
}

/// รูป/วิดีโอในอัลบั้ม — ชี้ไปที่ไฟล์เดิม (chat.files.url) ไม่ได้ก๊อปซ้ำ ไม่เปลืองพื้นที่เพิ่ม
/// ไฟล์ที่มีแถวที่นี่ (url หรือ thumbUrl) = ห้ามลบตอนเก็บกวาดไฟล์หมดอายุ
model ChatAlbumItem {
  orgId           String   @map("org_id")
  id              String   @id @default(uuid())
  albumId         String   @map("album_id")
  url             String
  thumbUrl        String?  @map("thumb_url")
  kind            String
  mime            String
  name            String
  width           Int?
  height          Int?
  /// ข้อความต้นทางในแชท (บันทึกจากแชท) — null = อัปโหลดเข้าอัลบั้มตรง
  sourceMessageId String?  @map("source_message_id")
  addedById       String   @map("added_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  album ChatAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, url])
  @@index([orgId, url])
  @@index([orgId, thumbUrl])
  @@map("album_items")
  @@schema("chat")
}

/// โน้ตของห้องแชท (แบบ LINE) — ข้อความยาว + รูป ถาวร (ไม่หมดอายุแบบรูปในแชท)
/// สร้างแล้วโพสต์ "การ์ดโน้ต" (chat.messages kind = "note") ลงห้อง ⇒ แจ้งเตือน/ยังไม่อ่านใช้ทางเดียวกับข้อความ
model ChatNote {
  orgId       String   @map("org_id")
  id          String   @id @default(uuid())
  channelId   String   @map("channel_id")
  authorId    String   @map("author_id")
  body        String
  /// [{ url, name, mime, size, kind: "image", thumbUrl?, width?, height? }] — ไฟล์ใน chat.files
  attachments Json     @default("[]")
  /// การ์ดโน้ตในห้อง
  messageId   String?  @unique @map("message_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel  ChatChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  comments ChatNoteComment[]
  likes    ChatNoteLike[]

  @@index([orgId, channelId, createdAt])
  @@map("notes")
  @@schema("chat")
}

model ChatNoteComment {
  orgId     String   @map("org_id")
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  note ChatNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@index([orgId])
  @@map("note_comments")
  @@schema("chat")
}

model ChatNoteLike {
  orgId     String   @map("org_id")
  noteId    String   @map("note_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  note ChatNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([orgId])
  @@map("note_likes")
  @@schema("chat")
}

/// หมวดสติกเกอร์ของบริษัท (แบบชุดสติกเกอร์ของ LINE) — แอดมินแชทตั้งชื่อ/เรียงลำดับเอง
model ChatStickerPack {
  orgId       String   @map("org_id")
  id          String   @id @default(uuid())
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  stickers ChatSticker[]

  @@index([orgId, sortOrder])
  @@map("sticker_packs")
  @@schema("chat")
}

/// สติกเกอร์ของบริษัท (แบบ LINE แต่ทำเองภายใน) — แอดมินแชทเพิ่ม/ลบ/เรียง ทุกคนในบริษัทใช้ได้ทั้งแชทและรายงาน
/// ไฟล์อยู่ใน chat.files (kind "sticker") ไม่หมดอายุ · ลบสติกเกอร์ = เอาออกจากชุด ไฟล์ยังอยู่
/// ให้ข้อความเก่าที่เคยส่งไปยังแสดงได้ · packId null = ยังไม่ได้จัดหมวด ("ทั่วไป")
model ChatSticker {
  orgId       String   @map("org_id")
  id          String   @id @default(uuid())
  packId      String?  @map("pack_id")
  name        String
  /// คำค้นเพิ่มเติม คั่นด้วยช่องว่าง (ชื่อค้นได้อยู่แล้ว)
  keywords    String   @default("")
  url         String
  mime        String
  size        Int
  width       Int?
  height      Int?
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  pack ChatStickerPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([orgId, packId, sortOrder])
  @@map("stickers")
  @@schema("chat")
}

/// โทรในแชท (เสียงผ่าน LiveKit) — หนึ่งแถวต่อหนึ่งสาย · ใช้ทั้งคุมสถานะสาย (เรียกเข้า/คุยอยู่/จบ) และนับนาทีที่แต่ละบริษัท
/// ใช้ไว้คิดเงินลูกค้า (ระบบนี้ขายให้บริษัทอื่นด้วย) · ห้อง LiveKit = `call-<id>` ผูกบริษัทผ่าน orgId เท่านั้น
model ChatCall {
  id        String @id @default(uuid())
  orgId     String @map("org_id")
  channelId String @map("channel_id")
  callerId  String @map("caller_id")
  calleeId  String @map("callee_id")
  /// "audio" (ตอนนี้) | "video" (ทีหลัง)
  media     String @default("audio")
  /// ringing → active → ended · หรือ ringing → missed (ไม่มีคนรับ) / declined (ปฏิเสธ) / cancelled (ผู้โทรวางก่อนรับ)
  status    String @default("ringing")

  createdAt  DateTime  @default(now()) @map("created_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")
  /// ใครกดวาง / ปฏิเสธ (null = ระบบตัดเพราะหมดเวลา)
  endedBy    String?   @map("ended_by")

  @@index([orgId, createdAt])
  @@index([calleeId, status])
  @@index([callerId, status])
  @@map("calls")
  @@schema("chat")
}
