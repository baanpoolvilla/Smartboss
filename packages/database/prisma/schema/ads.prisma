// ═══════════════════════════════════════════════════════════════════════
//  schema "ads" — โมดูล Google Ads Report (spec: google-ads-report-module-spec.md §4)
//
//  ชื่อตาราง/คอลัมน์ตาม spec ทุกตัว ต่างกันแค่:
//    - `tenant_id INT` ของ spec = `org_id` ของ Smartboss และมีทุกตาราง (ไม่ใช่แค่
//      ads_accounts) — ตาม module contract ของระบบ ทุก query กรองด้วย orgId แล้ว
//      tenant-guard ตรวจซ้ำได้
//    - ENUM / AUTO_INCREMENT ของ MySQL → String ตรวจค่าในโค้ด / autoincrement()
//  orgId เป็นคอลัมน์ธรรมดาไม่ผูก @relation ข้าม schema — สไตล์เดียวกับ
//  company_files.prisma และ maintenance.prisma
// ═══════════════════════════════════════════════════════════════════════

/// บัญชีโฆษณา
model AdsAccount {
  customerId    String    @id @map("customer_id") @db.VarChar(20)
  orgId         String    @map("org_id")
  name          String?   @db.VarChar(255)
  currencyCode  String?   @map("currency_code") @db.Char(3)
  timeZone      String?   @map("time_zone") @db.VarChar(64)
  syncEnabled   Boolean   @default(true) @map("sync_enabled")
  lastSyncedAt  DateTime? @map("last_synced_at")

  @@index([orgId])
  @@map("ads_accounts")
  @@schema("ads")
}

/// ข้อมูลแคมเปญ (dimension)
model AdsCampaign {
  campaignId  BigInt    @id @map("campaign_id")
  orgId       String    @map("org_id")
  customerId  String    @map("customer_id") @db.VarChar(20)
  name        String?   @db.VarChar(255)
  status      String?   @db.VarChar(20)
  channelType String?   @map("channel_type") @db.VarChar(40)
  dailyBudget Decimal?  @map("daily_budget") @db.Decimal(14, 2)
  updatedAt   DateTime? @map("updated_at")

  @@index([orgId, customerId])
  @@map("ads_campaigns")
  @@schema("ads")
}

/// ข้อมูลกลุ่มโฆษณา (dimension)
model AdsAdGroup {
  adGroupId  BigInt    @id @map("ad_group_id")
  orgId      String    @map("org_id")
  campaignId BigInt    @map("campaign_id")
  name       String?   @db.VarChar(255)
  status     String?   @db.VarChar(20)
  updatedAt  DateTime? @map("updated_at")

  @@index([orgId, campaignId])
  @@map("ads_ad_groups")
  @@schema("ads")
}

/// ผลรายวันระดับแคมเปญ (fact) — เก็บเฉพาะค่าดิบ (§3.3) · impression share
/// เป็นอัตราส่วนรายวัน สรุปหลายวันด้วยค่าเฉลี่ยถ่วงน้ำหนักด้วย impressions
model AdsCampaignDaily {
  campaignId         BigInt   @map("campaign_id")
  date               DateTime @db.Date
  orgId              String   @map("org_id")
  impressions        BigInt?
  clicks             BigInt?
  cost               Decimal? @db.Decimal(14, 2)
  conversions        Decimal? @db.Decimal(14, 4)
  conversionsValue   Decimal? @map("conversions_value") @db.Decimal(14, 2)
  searchImprShare    Decimal? @map("search_impr_share") @db.Decimal(6, 4)
  searchBudgetLostIs Decimal? @map("search_budget_lost_is") @db.Decimal(6, 4)
  searchRankLostIs   Decimal? @map("search_rank_lost_is") @db.Decimal(6, 4)
  topImprPct         Decimal? @map("top_impr_pct") @db.Decimal(6, 4)
  absTopImprPct      Decimal? @map("abs_top_impr_pct") @db.Decimal(6, 4)

  @@id([campaignId, date])
  @@index([orgId, date])
  @@map("ads_campaign_daily")
  @@schema("ads")
}

/// ผลรายวันระดับกลุ่มโฆษณา (fact)
model AdsAdGroupDaily {
  adGroupId        BigInt   @map("ad_group_id")
  date             DateTime @db.Date
  orgId            String   @map("org_id")
  impressions      BigInt?
  clicks           BigInt?
  cost             Decimal? @db.Decimal(14, 2)
  conversions      Decimal? @db.Decimal(14, 4)
  conversionsValue Decimal? @map("conversions_value") @db.Decimal(14, 2)
  topImprPct       Decimal? @map("top_impr_pct") @db.Decimal(6, 4)
  absTopImprPct    Decimal? @map("abs_top_impr_pct") @db.Decimal(6, 4)

  @@id([adGroupId, date])
  @@index([orgId, date])
  @@map("ads_ad_group_daily")
  @@schema("ads")
}

/// ผลรายวันระดับคีย์เวิร์ด
model AdsKeywordDaily {
  criterionId BigInt   @map("criterion_id")
  adGroupId   BigInt   @map("ad_group_id")
  date        DateTime @db.Date
  orgId       String   @map("org_id")
  keywordText String?  @map("keyword_text") @db.VarChar(255)
  matchType   String?  @map("match_type") @db.VarChar(20)
  impressions BigInt?
  clicks      BigInt?
  cost        Decimal? @db.Decimal(14, 2)
  conversions Decimal? @db.Decimal(14, 4)

  @@id([adGroupId, criterionId, date])
  @@index([orgId, date])
  @@map("ads_keyword_daily")
  @@schema("ads")
}

/// คำค้นหาจริงรายวัน
model AdsSearchTermDaily {
  id          BigInt   @id @default(autoincrement())
  orgId       String   @map("org_id")
  adGroupId   BigInt   @map("ad_group_id")
  date        DateTime @db.Date
  searchTerm  String?  @map("search_term") @db.VarChar(500)
  impressions BigInt?
  clicks      BigInt?
  cost        Decimal? @db.Decimal(14, 2)
  conversions Decimal? @db.Decimal(14, 4)

  @@unique([adGroupId, date, searchTerm])
  @@index([orgId, date])
  @@map("ads_search_term_daily")
  @@schema("ads")
}

/// เกณฑ์ KPI (แก้ได้จากหน้าตั้งค่า) — customerId = null คือค่าเริ่มต้นทุกบัญชีของบริษัท
/// direction: "higher_better" | "lower_better" — ตรวจในโค้ด
model AdsKpiBenchmark {
  id            Int     @id @default(autoincrement())
  orgId         String  @map("org_id")
  customerId    String? @map("customer_id") @db.VarChar(20)
  metric        String  @db.VarChar(40)
  direction     String  @db.VarChar(20)
  poorThreshold Decimal @map("poor_threshold") @db.Decimal(12, 4)
  goodThreshold Decimal @map("good_threshold") @db.Decimal(12, 4)

  @@index([orgId, customerId])
  @@map("ads_kpi_benchmarks")
  @@schema("ads")
}

/// กฎตรวจสอบก่อนส่งให้ AI และเป้าหมายธุรกิจ (รายบัญชี)
/// primaryGoal: "lead" | "sales" — ตรวจในโค้ด
model AdsAnalysisSetting {
  customerId           String   @id @map("customer_id") @db.VarChar(20)
  orgId                String   @map("org_id")
  minClicksToJudge     Int      @default(50) @map("min_clicks_to_judge")
  minBudgetUtilToScale Decimal  @default(80) @map("min_budget_util_to_scale") @db.Decimal(5, 2)
  budgetLostIsLimit    Decimal  @default(10) @map("budget_lost_is_limit") @db.Decimal(5, 2)
  rankLostIsLimit      Decimal  @default(30) @map("rank_lost_is_limit") @db.Decimal(5, 2)
  /// เกณฑ์ "คำค้นหาใช้เงินแต่ไม่มี conversion" (§5.4 ค่าเริ่มต้น 10 คลิก) — spec
  /// ไม่มีคอลัมน์นี้ แต่เกณฑ์ธุรกิจต้องเป็นการตั้งค่า ไม่ใช่เลขฝังในโค้ด
  wastedTermMinClicks  Int      @default(10) @map("wasted_term_min_clicks")
  primaryGoal          String   @default("lead") @map("primary_goal") @db.VarChar(10)
  targetCpa            Decimal? @map("target_cpa") @db.Decimal(12, 2)
  avgLeadValue         Decimal? @map("avg_lead_value") @db.Decimal(12, 2)
  businessContext      String?  @map("business_context")
  /// ผู้รับอีเมลสรุปรายสัปดาห์ (§11 ข้อ 5) คั่นด้วย , หรือขึ้นบรรทัดใหม่
  emailRecipients      String?  @map("email_recipients")

  @@index([orgId])
  @@map("ads_analysis_settings")
  @@schema("ads")
}

/// token ที่ออกให้ n8n เรียก API ของ Smartboss (/api/agent/ads/*) — เก็บแค่ hash
/// ตัว token เต็มแสดงครั้งเดียวตอนสร้าง · revokedAt ไม่ null = ใช้ไม่ได้แล้ว
model AdsAgentToken {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  name        String    @db.VarChar(100)
  /// 12 ตัวแรกของ token ไว้ให้คนจำได้ว่าตัวไหน (sbads_xxxxxx)
  tokenPrefix String    @map("token_prefix") @db.VarChar(20)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([orgId])
  @@map("ads_agent_tokens")
  @@schema("ads")
}

/// การเชื่อมต่อ n8n + นโยบายคำขอปรับ (รายบริษัท)
model AdsAgentSetting {
  orgId             String    @id @map("org_id")
  /// URL ของ Webhook node ใน n8n ที่รับเหตุการณ์จาก Smartboss — null = ยังไม่ส่ง
  webhookUrl        String?   @map("webhook_url")
  /// ใช้เซ็น HMAC-SHA256 ทุก webhook (n8n ใช้ตรวจว่ามาจาก Smartboss จริง)
  webhookSecret     String?   @map("webhook_secret") @db.VarChar(100)
  /// ประเภทคำขอที่เปิดให้ n8n เสนอได้ (ดู lib/proposal-types.ts)
  allowedTypes      String[]  @default([]) @map("allowed_types")
  /// ปรับงบรายวันได้ไม่เกินกี่ % ต่อครั้ง
  maxBudgetChangePct Decimal  @default(30) @map("max_budget_change_pct") @db.Decimal(6, 2)
  /// คำขอที่ไม่มีใครตัดสินภายในกี่ชั่วโมง ถือว่าหมดอายุ
  proposalExpiryHours Int     @default(72) @map("proposal_expiry_hours")
  /// คนสั่งงานบอทเอง อนุมัติคำขอของตัวเองได้ไหม
  selfApprove       Boolean   @default(true) @map("self_approve")
  /// n8n ส่ง heartbeat มาล่าสุดเมื่อไหร่ · ข้อมูลประกอบ (เวอร์ชัน/ชื่อ workflow)
  lastSeenAt        DateTime? @map("last_seen_at")
  lastSeenInfo      Json?     @map("last_seen_info")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("ads_agent_settings")
  @@schema("ads")
}

/// บทสรุป/บทวิเคราะห์ที่ AI บน n8n ส่งเข้ามา — แสดงบนแดชบอร์ด
model AdsSummary {
  id         BigInt    @id @default(autoincrement())
  orgId      String    @map("org_id")
  customerId String?   @map("customer_id") @db.VarChar(20)
  periodFrom DateTime? @map("period_from") @db.Date
  periodTo   DateTime? @map("period_to") @db.Date
  title      String    @db.VarChar(255)
  body       String
  /// [{ label, value, tone? }] ตัวเลขเด่นที่อยากโชว์เป็นป้าย — ไม่บังคับ
  highlights Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([orgId, customerId, createdAt])
  @@map("ads_summaries")
  @@schema("ads")
}

/// คำขอปรับ Google Ads — แหล่งความจริงเดียวของสถานะ (n8n ไม่เก็บสถานะเอง)
/// status: pending → approved → executing → applied | failed | stale
///         pending → rejected | expired
model AdsChangeProposal {
  id            String    @id @default(uuid())
  orgId         String    @map("org_id")
  /// เลขให้คนอ่าน ADS-2569-0001 — เดินเลขแยกตามบริษัทและปี พ.ศ.
  code          String    @db.VarChar(20)
  customerId    String    @map("customer_id") @db.VarChar(20)
  /// ดู lib/proposal-types.ts
  type          String    @db.VarChar(40)
  /// "ai" = AI เสนอเอง · "command" = มีคนพิมพ์สั่งบอท
  source        String    @default("ai") @db.VarChar(10)
  /// คนที่พิมพ์สั่ง (source = command)
  requestedBy   String?   @map("requested_by")
  campaignId    String?   @map("campaign_id") @db.VarChar(30)
  campaignName  String?   @map("campaign_name") @db.VarChar(255)
  adGroupId     String?   @map("ad_group_id") @db.VarChar(30)
  adGroupName   String?   @map("ad_group_name") @db.VarChar(255)
  /// id ของสิ่งที่ถูกปรับ (keyword criterion id / ad group id / campaign id) ตามประเภท
  targetId      String?   @map("target_id") @db.VarChar(60)
  targetName    String?   @map("target_name") @db.VarChar(500)
  /// ค่าเดิมตอนเสนอ — n8n ต้องเทียบกับค่าจริงใน Google ก่อนยิง
  before        Json?
  /// ค่าที่เสนอ
  proposed      Json
  /// ค่าที่อนุมัติจริง (คนแก้/ติ๊กบางรายการออกได้) — null จนกว่าจะอนุมัติ
  approved      Json?
  reason        String
  /// [{ label, value }] ตัวเลขประกอบเหตุผล
  evidence      Json?
  /// low | medium | high
  risk          String    @default("medium") @db.VarChar(10)
  expectedImpact String?  @map("expected_impact")
  status        String    @default("pending") @db.VarChar(15)
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  /// n8n จองไปยิงเมื่อไหร่ (approved → executing)
  claimedAt     DateTime? @map("claimed_at")
  executedAt    DateTime? @map("executed_at")
  /// ผลจาก Google (resource name, ค่าหลังปรับ) / ข้อความ error
  result        Json?
  error         String?
  /// ผลวัดหลังปรับ { "7": {...}, "14": {...} }
  measurement   Json?
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([orgId, code])
  @@index([orgId, status, createdAt])
  @@map("ads_change_proposals")
  @@schema("ads")
}

/// log การรับข้อมูลจาก n8n (เดิม: การซิงค์ของ Smartboss เอง) · jobType: n8n (แถวเก่า daily|manual|backfill) · status: success|retried|failed
model AdsSyncLog {
  id           BigInt    @id @default(autoincrement())
  orgId        String    @map("org_id")
  customerId   String?   @map("customer_id") @db.VarChar(20)
  jobType      String?   @map("job_type") @db.VarChar(10)
  rangeFrom    DateTime? @map("range_from") @db.Date
  rangeTo      DateTime? @map("range_to") @db.Date
  rowsUpserted Int?      @map("rows_upserted")
  durationMs   Int?      @map("duration_ms")
  status       String?   @db.VarChar(10)
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")

  @@index([orgId, customerId, startedAt])
  @@map("ads_sync_logs")
  @@schema("ads")
}
