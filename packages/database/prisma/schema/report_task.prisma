// ═══════════════════════════════════════════════════════════════════════
//  schema "report_task" — โมดูลรายงานและงาน
//  เจ้าของ: branch module/report_task
// ═══════════════════════════════════════════════════════════════════════

// ═════════════════════ งานในบอร์ด Kanban ═════════════════════
//
// เดิมเก็บทั้งคอลเลกชันเป็นก้อน JSON ก้อนเดียวใน report_task.stores คีย์ "tasks"
// (ต้นทางเก็บเป็นไฟล์ data/tasks/tasks.json) ⇒ แก้ชื่องานตัวเดียวก็ต้องเขียนทับ
// ทั้งบริษัท และฝั่งเซิร์ฟเวอร์ query อะไรไม่ได้เลยนอกจากโหลดมาทั้งก้อน
//
// ตอนนี้เป็นตารางจริง หนึ่งแถวต่อหนึ่งงาน
//
// ⚠ `data` คือ **แหล่งความจริง** ของตัวงานทั้งก้อน ส่วนคอลัมน์อื่นเป็นสำเนา
// ที่คัดออกมาเพื่อให้ query/เรียง/ทำดัชนีได้ — เขียนจากที่เดียวเสมอ (task-repo.ts)
// จึงไม่มีทางไม่ตรงกัน เหตุที่ไม่แตกทุกฟิลด์เป็นคอลัมน์: ตัวงานมีโครงสร้างซ้อน
// อีกสิบกว่าชุด (เช็คลิสต์ คอมเมนต์ ไฟล์แนบ ประวัติแก้ไข รีแอ็กชัน การหักคะแนน)
// ซึ่งเป็นของ UI ต้นทางที่ปรับรูปร่างได้ตลอด แตกเป็นตารางแล้วต้องตามแก้ทุกครั้ง
model ReportTask {
  orgId String @map("org_id")
  /// id ที่ client สร้าง (task-xxxx) — ไม่ใช่ uuid ของเรา
  id    String
  /// เลขที่ให้คนอ่าน T-2569-0001 — เซิร์ฟเวอร์เป็นคนตั้ง client ไม่ต้องรู้
  code  String

  title        String
  status       String
  priority     String
  taskMode     String   @map("task_mode")
  assignedById String   @map("assigned_by_id")
  assigneeIds  String[] @map("assignee_ids")
  parentId     String?  @map("parent_id")
  startDate    String   @map("start_date")
  dueDate      String   @map("due_date")
  completedAt  String?  @map("completed_at")

  /// ตัวงานทั้งก้อนตามรูปแบบของ UI ต้นทาง
  data Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@map("tasks")
  @@schema("report_task")
}

/// ตัวนับรุ่นของ "คอลเลกชันงาน" ทั้งบริษัท
///
/// client ส่งงานมาทั้งชุดทุกครั้ง (สัญญาเดิมของ UI ต้นทาง) จึงต้องมีเลขรุ่นของ
/// ทั้งชุดไว้กันสองแท็บเขียนทับกัน — เดิมเลขนี้อยู่ในแถวของ stores
model ReportTaskCollection {
  orgId     String   @id @map("org_id")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("task_collections")
  @@schema("report_task")
}

// ═══════════════════════════ report_task ═══════════════════════════
// โมดูลรายงานและงาน (พอร์ตจากแอป easyboss-workspace)
//
// ฝั่ง client เก็บสถานะที่แชร์กันทั้งทีมไว้ใน zustand store ~15 ตัว แล้วเขียนกลับ
// ผ่าน endpoint เดียว `/api/report-task/store/{key}` (กับ `/tasks` อีกตัว)
// ⇒ ฝั่งเซิร์ฟเวอร์จึงเก็บเป็น "ก้อน JSON ต่อคีย์ ต่อบริษัท" ก้อนเดียวจบ
//
// ทำไมไม่แตกเป็นตารางต่อ entity: รูปร่างข้อมูลยังเปลี่ยนบ่อยตามการพัฒนาฝั่ง
// workspace และสัญญาระหว่าง client กับ server คือ "ทั้งก้อน" อยู่แล้ว
// (โหลดทั้งก้อนตอน mount เขียนทั้งก้อนตอนเปลี่ยน) การแตกตารางตอนนี้จะได้
// ความซับซ้อนโดยไม่ได้ประโยชน์ — แตกทีหลังได้เมื่อ schema นิ่ง
//
// version = optimistic concurrency ป้องกันสองแท็บเขียนทับกัน (client ส่ง
// expectedVersion มา ไม่ตรงกัน = 409 ให้โหลดใหม่)
model ReportTaskStore {
  orgId     String   @map("org_id")
  key       String
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // ผู้ใช้คนล่าสุดที่เขียน — ไว้ไล่ย้อนตอนข้อมูลเพี้ยน

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("stores")
  @@schema("report_task")
}

// ═══════════════════════ Discord Report Sync (ชั่วคราว) ═══════════════════════
//
// ตัวเชื่อม Discord → SmartBoss ชั่วคราว รอแอปมือถือ — ถอดทั้งชุดได้เมื่อเลิกใช้
// โดยไม่แตะ HR/Performance (ดู docs/discord_report_integration.md)
//
//   discord_links     ผูก Discord user → พนักงาน (core.users.id)
//   discord_channels  ผูกห้อง Discord → ReportTopic + กฎรอบ (กรอกเองในหน้าตั้งค่า)
//   report_submissions เก็บการส่งดิบ ต่อคน/วัน/รอบ ไว้ตรวจย้อนหลัง

/// ผูกด้วย Discord User ID (ชื่อ Discord เปลี่ยนได้ id ไม่เปลี่ยน)
model DiscordLink {
  orgId         String   @map("org_id")
  discordUserId String   @map("discord_user_id")
  employeeId    String   @map("employee_id") // core.users.id
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, discordUserId])
  @@index([orgId, employeeId])
  @@map("discord_links")
  @@schema("report_task")
}

/// ผูกด้วย Channel ID (ชื่อห้องซ้ำกันได้หลายแผนก) + กฎรอบที่แอดมินกรอกเอง
///
/// rounds = [{ id, label, time("HH:mm"), minImages }] — ล้อ ReportCutoff ฝั่ง client
/// keywordOnly = true → นับเฉพาะโพสต์ที่มีคำว่า `keyword` (เช่น "daily")
///               false → ทุกโพสต์ในห้องนับเป็นการส่ง
model DiscordChannel {
  orgId            String   @map("org_id")
  discordChannelId String   @map("discord_channel_id")
  topicId          String   @map("topic_id") // ล้อ ReportTopic
  label            String   @default("") // ชื่อ/แผนก ไว้แสดงในหน้าแอดมิน
  rounds           Json     @default("[]") // [{id,label,time,minImages}]
  minImages        Int      @default(0) @map("min_images") // ค่ากลางของห้อง
  requiredWeekdays Int[]    @default([]) @map("required_weekdays") // 0=อา..6=ส ว่าง=ยึด roster
  useRoster        Boolean  @default(true) @map("use_roster") // ยึดวันทำงานจาก HR roster
  keywordOnly      Boolean  @default(false) @map("keyword_only")
  keyword          String   @default("daily")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, discordChannelId])
  @@map("discord_channels")
  @@schema("report_task")
}

/// การส่งดิบจาก Discord — ต่อคน/วัน/รอบ (idempotent ด้วย messageId)
model ReportSubmission {
  orgId         String    @map("org_id")
  id            String    @default(uuid())
  employeeId    String?   @map("employee_id") // null = ยังผูกตัวตนไม่ได้
  discordUserId String    @map("discord_user_id")
  channelId     String    @map("channel_id")
  topicId       String    @map("topic_id")
  roundId       String    @map("round_id")
  reportDate    DateTime  @map("report_date") @db.Date
  postedAt      DateTime? @map("posted_at")
  messageId     String    @map("message_id")
  imageCount    Int       @default(0) @map("image_count")
  content       String    @default("")
  status        String? // on-time | late | missed | image-incomplete | exempt
  createdAt     DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, messageId])
  @@index([orgId, topicId, reportDate])
  @@index([orgId, employeeId, reportDate])
  @@map("report_submissions")
  @@schema("report_task")
}
