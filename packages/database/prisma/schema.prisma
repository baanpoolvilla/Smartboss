generator client {
  provider = "prisma-client-js"
  // native = เครื่อง dev (Windows) · debian = WSL/Linux · rhel = Vercel serverless (Amazon Linux)
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url = pooled endpoint (Neon pooler) — app runtime บน serverless ใช้เส้นนี้
  url       = env("DATABASE_URL")
  // directUrl = unpooled endpoint — prisma migrate/studio ใช้เส้นตรง (ชื่อ env ตาม Neon/Vercel integration)
  directUrl = env("DATABASE_URL_UNPOOLED")
  schemas   = ["core", "maintenance", "report_task"]
}

model User {
  id           String    @id @default(uuid())
  orgId        String?   @map("org_id") // null = platform-level user (super admin ข้ามทุกบริษัท)
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  avatarUrl    String?   @map("avatar_url")
  lineUserId   String?   @map("line_user_id") // ผูกกับ LINE เพื่อส่งแจ้งเตือน (ไม่ใช่ login)
  isActive     Boolean   @default(true) @map("is_active")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization  Organization?  @relation(fields: [orgId], references: [id])
  roles             UserRole[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  performanceEvents PerformanceEvent[]

  @@index([orgId])
  @@map("users")
  @@schema("core")
}

// บริษัทลูกค้า (tenant). ทุกข้อมูลของโมดูลจะผูกกับ org นี้
model Organization {
  id        String   @id @default(uuid())
  slug      String   @unique // ตัวระบุสั้น (เผื่อ subdomain) เช่น "acme"
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  planCode  String?  @map("plan_code") // แพ็กเกจ subscription (FREE, PRO, ...) — เก็บเป็น code ไปก่อน
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  orgModules OrgModule[]
  roles      Role[]

  reportTaskStores   ReportTaskStore[]
  performanceEvents  PerformanceEvent[]
  performanceSetting PerformanceSetting?

  @@map("organizations")
  @@schema("core")
}

// บริษัทนี้ "เปิดใช้" โมดูลไหนบ้าง = แกนของ subscription per-tenant
model OrgModule {
  orgId     String   @map("org_id")
  moduleId  String   @map("module_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([orgId, moduleId])
  @@index([moduleId])
  @@map("org_modules")
  @@schema("core")
}

// บทบาท — แยกตามบริษัท (orgId) เพื่อไม่ให้บริษัทหนึ่งแก้สิทธิ์แล้วกระทบอีกบริษัท
// orgId = null → role กลางของแพลตฟอร์ม (SUPER_ADMIN ฯลฯ) ทุกบริษัทเห็น แต่แก้ไม่ได้
model Role {
  id          String  @id @default(uuid())
  orgId       String? @map("org_id")
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system") // true = role กลาง ห้ามแก้/ลบ

  organization Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("roles")
  @@schema("core")
}

model Permission {
  id       String  @id @default(uuid())
  code     String  @unique
  moduleId String? @map("module_id")

  module Module?          @relation(fields: [moduleId], references: [id])
  roles  RolePermission[]

  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("core")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("core")
}

model Module {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  color     String
  isEnabled Boolean @default(false) @map("is_enabled") // มีในแคตตาล็อกแพลตฟอร์มไหม
  sortOrder Int     @default(0) @map("sort_order")

  permissions Permission[]
  orgModules  OrgModule[]

  @@map("modules")
  @@schema("core")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  module    String   @default("core")
  action    String
  targetId  String?  @map("target_id")
  ip        String?
  userAgent String?  @map("user_agent")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
  @@schema("core")
}

// ── โมดูลตัวอย่าง (แม่แบบ) ────────────────────────────────
// ตารางของโมดูลผูกกับ org_id เสมอ = ข้อมูลแยกตามบริษัท (tenant)
model ExampleItem {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  title     String
  note      String?
  status    String   @default("open") // open | done
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("example_items")
  @@schema("core")
}

// แจ้งเตือนในแอป (ใช้ข้ามโมดูล) — สร้างโดย app logic
model Notification {
  id          String    @id @default(uuid())
  orgId       String?   @map("org_id")
  userId      String    @map("user_id")
  title       String
  body        String?
  type        String    @default("general")
  referenceId String?   @map("reference_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("core")
}

// ═══════════════════════════════════════════════════════════
//  MAINTENANCE MODULE (port จาก ChangYai — Property Operations)
//  ทุกตารางมี org_id (multi-tenant). อ้าง user เป็น core.users.id (UUID string)
// ═══════════════════════════════════════════════════════════

model Property {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  address      String?
  ownerName    String?  @map("owner_name")
  ownerContact String?  @map("owner_contact")
  notes        String?
  caretakerId  String?  @map("caretaker_id") // core.users.id
  category     String?
  createdAt    DateTime @default(now()) @map("created_at")

  assets      Asset[]
  workOrders  WorkOrder[]
  pmSchedules PmSchedule[]

  @@index([orgId])
  @@map("properties")
  @@schema("maintenance")
}

model PropertyCategory {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  prefix      String
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orgId, prefix])
  @@map("property_categories")
  @@schema("maintenance")
}

model Asset {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  propertyId     String    @map("property_id")
  name           String
  category       String?
  brand          String?
  model          String?
  installDate    DateTime? @map("install_date") @db.Date
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  notes          String?
  imageUrl       String?   @map("image_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  workOrders  WorkOrder[]
  pmSchedules PmSchedule[]

  @@index([orgId])
  @@index([propertyId])
  @@map("assets")
  @@schema("maintenance")
}

model WorkOrder {
  id                    String    @id @default(uuid())
  orgId                 String    @map("org_id")
  propertyId            String    @map("property_id")
  assetId               String?   @map("asset_id")
  assignedTo            String?   @map("assigned_to") // core.users.id
  createdBy             String?   @map("created_by")
  title                 String
  description           String?
  status                String    @default("open") // open|in_progress|completed|cancelled
  priority              String    @default("medium") // low|medium|high|urgent
  dueDate               DateTime? @map("due_date")
  completedAt           DateTime? @map("completed_at")
  completionNotes       String?   @map("completion_notes")
  photoUrls             String[]  @map("photo_urls")
  afterPhotoUrls        String[]  @map("after_photo_urls")
  ccUserIds             String[]  @map("cc_user_ids")
  additionalPropertyIds String[]  @map("additional_property_ids")
  pmScheduleId          String?   @map("pm_schedule_id")
  pmScheduleIds         String[]  @map("pm_schedule_ids")
  autoCreated           Boolean   @default(false) @map("auto_created")
  createdAt             DateTime  @default(now()) @map("created_at")

  property       Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset          Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  comments       WorkOrderComment[]
  externalPhotos WorkOrderExternalPhoto[]
  uploadLinks    WorkOrderUploadLink[]

  @@index([orgId])
  @@index([propertyId])
  @@index([assignedTo])
  @@index([status])
  @@map("work_orders")
  @@schema("maintenance")
}

model WorkOrderComment {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  workOrderId String   @map("work_order_id")
  userId      String?  @map("user_id")
  content     String
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workOrderId])
  @@map("work_order_comments")
  @@schema("maintenance")
}

model WorkOrderExternalPhoto {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  workOrderId String   @map("work_order_id")
  storagePath String   @map("storage_path")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workOrderId])
  @@map("work_order_external_photos")
  @@schema("maintenance")
}

model WorkOrderUploadLink {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  workOrderId String    @map("work_order_id")
  token       String    @unique
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workOrderId])
  @@map("work_order_upload_links")
  @@schema("maintenance")
}

model Expense {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  workOrderId       String?  @map("work_order_id")
  pmScheduleId      String?  @map("pm_schedule_id")
  purchaseOrderId   String?  @map("purchase_order_id")
  propertyId        String?  @map("property_id")
  amount            Decimal  @db.Decimal(12, 2)
  description       String?
  category          String?
  receiptUrl        String?  @map("receipt_url")
  billableToPartner Boolean  @default(false) @map("billable_to_partner")
  costType          String   @default("work_order") @map("cost_type") // work_order|pm
  paidBy            String   @default("company") @map("paid_by") // company|owner
  isNoExpense       Boolean  @default(false) @map("is_no_expense")
  expenseDate       DateTime @default(now()) @map("expense_date") @db.Date
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@index([workOrderId])
  @@index([propertyId])
  @@map("expenses")
  @@schema("maintenance")
}

model PmSchedule {
  id                String    @id @default(uuid())
  orgId             String    @map("org_id")
  propertyId        String    @map("property_id")
  assetId           String?   @map("asset_id")
  title             String
  description       String?
  frequency         String    @default("monthly")
  nextDueDate       DateTime  @map("next_due_date") @db.Date
  anchorDate        DateTime? @map("anchor_date") @db.Date
  roundsPerYear     Int?      @map("rounds_per_year")
  totalRounds       Int?      @map("total_rounds")
  roundsDone        Int       @default(0) @map("rounds_done")
  awaitingSchedule  Boolean   @default(false) @map("awaiting_schedule")
  lastCompletedDate DateTime? @map("last_completed_date") @db.Date
  isActive          Boolean   @default(true) @map("is_active")
  assignedTo        String?   @map("assigned_to")
  ccUserIds         String[]  @map("cc_user_ids")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([propertyId])
  @@index([nextDueDate])
  @@map("pm_schedules")
  @@schema("maintenance")
}

model Contractor {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  phone       String?
  email       String?
  specialty   String?
  companyName String?  @map("company_name")
  notes       String?
  zone        String?
  rating      Int?
  isActive    Boolean  @default(true) @map("is_active")
  price       Decimal? @db.Decimal(12, 2)
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  history ContractorHistory[]

  @@index([orgId])
  @@map("contractors")
  @@schema("maintenance")
}

model ContractorHistory {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  contractorId String    @map("contractor_id")
  workOrderId  String?   @map("work_order_id")
  propertyId   String?   @map("property_id")
  description  String?
  amount       Decimal?  @db.Decimal(12, 2)
  workDate     DateTime? @map("work_date") @db.Date
  rating       Int?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([contractorId])
  @@map("contractor_history")
  @@schema("maintenance")
}

model PurchaseOrder {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  title               String
  description         String?
  propertyId          String?  @map("property_id")
  createdBy           String?  @map("created_by")
  poAssignedTo        String?  @map("po_assigned_to")
  status              String    @default("pending") // pending|approved|ordered|received|cancelled
  items               Json      @default("[]")
  totalPrice          Decimal   @default(0) @map("total_price") @db.Decimal(12, 2)
  notes               String?
  receiptImageUrl     String?   @map("receipt_image_url")
  receiptImageUrls    String[]  @map("receipt_image_urls")
  isSelfPurchase      Boolean   @default(false) @map("is_self_purchase")
  isEmergencyPurchase Boolean   @default(false) @map("is_emergency_purchase")
  emergencyReason     String?   @map("emergency_reason")
  prImageUrls         String[]  @map("pr_image_urls")
  // ผู้ทำ + เวลา ของแต่ละสเต็ปใน PR→PO flow (migration 058/060 เดิม)
  poCreatedBy         String?   @map("po_created_by")
  poCreatedAt         DateTime? @map("po_created_at")
  orderedBy           String?   @map("ordered_by")
  orderedAt           DateTime? @map("ordered_at")
  receivedBy          String?   @map("received_by")
  receivedAt          DateTime? @map("received_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  comments PurchaseOrderComment[]
  returns  EquipmentReturn[]

  @@index([orgId])
  @@index([status])
  @@map("purchase_orders")
  @@schema("maintenance")
}

model PurchaseOrderComment {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  purchaseOrderId String   @map("purchase_order_id")
  userId          String?  @map("user_id")
  content         String
  imageUrls       String[] @map("image_urls")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([purchaseOrderId])
  @@map("purchase_order_comments")
  @@schema("maintenance")
}

// คืนของ / ของมีปัญหา — ผูกกับใบสั่งซื้อเดิม (migration 059 เดิม)
model EquipmentReturn {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  purchaseOrderId String    @map("purchase_order_id")
  propertyId      String?   @map("property_id")
  itemName        String?   @map("item_name")
  qty             Int       @default(1)
  problemType     String    @default("other") @map("problem_type") // defective|wrong|damaged|missing|other
  reason          String
  status          String    @default("pending") // pending|processing|resolved|cancelled
  imageUrls       String[]  @map("image_urls")
  resolutionNote  String?   @map("resolution_note")
  createdBy       String?   @map("created_by")
  resolvedBy      String?   @map("resolved_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  resolvedAt      DateTime? @map("resolved_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("equipment_returns")
  @@schema("maintenance")
}

// LINE Messaging config ต่อองค์กร (แต่ละบริษัทมี LINE OA ของตัวเอง)
model LineConfig {
  orgId              String   @id @map("org_id")
  channelAccessToken String?  @map("channel_access_token")
  enabled            Boolean  @default(false)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("line_config")
  @@schema("maintenance")
}

model LineNotificationLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  userId     String?  @map("user_id")
  lineUserId String?  @map("line_user_id")
  message    String
  success    Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("line_notification_logs")
  @@schema("maintenance")
}

// ═════════════════════ คะแนนผลงานรายบุคคล (ข้ามโมดูล) ═════════════════════
// ทุกโมดูลส่ง "เหตุการณ์ที่มีผลต่อคะแนน" มาลงตารางเดียวกัน แล้วหน้าสรุปของ
// CEO/ผู้จัดการรวมจากที่นี่ที่เดียว — ไม่ต้องไปไล่ถามทีละโมดูล
//
// ทำไมเก็บเป็น "เหตุการณ์" ไม่ใช่ "คะแนนสะสม": คะแนนรวมคำนวณใหม่ได้เสมอ
// และย้อนดูได้ว่ามาจากเรื่องอะไรบ้าง ถ้าเก็บแต่ยอดรวมจะอธิบายที่มาไม่ได้
// และแก้ย้อนหลังไม่ได้เมื่อกฎเปลี่ยน
//
// points: ลบ = หัก, บวก = ได้เพิ่ม (สติกเกอร์ชม / งานเสร็จก่อนกำหนด)
model PerformanceEvent {
  id       String @id @default(uuid())
  orgId    String @map("org_id")
  /** core.users.id — คนที่ถูกให้/หักคะแนน */
  userId   String @map("user_id")
  /** โมดูลต้นทาง: report_task | maintenance | workforce */
  source   String
  /** ชนิดเหตุการณ์ เช่น task_late, pm_missed, workorder_overdue, attendance_late */
  category String
  points   Decimal @db.Decimal(6, 2)

  occurredAt DateTime @map("occurred_at")
  /** อ้างกลับไปที่ต้นเรื่อง เช่น work_order / pm_schedule / task */
  refType    String?  @map("ref_type")
  refId      String?  @map("ref_id")
  note       String?
  /** null = ระบบคำนวณเอง, มีค่า = คนกดหักเอง (core.users.id) */
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // กันหักซ้ำ — sweep รันทุก 60 วินาที ถ้าไม่มี unique นี้ งานเลยกำหนดใบเดียว
  // จะโดนหักซ้ำทุกรอบ เหตุการณ์เดียวกันจากต้นเรื่องเดียวกันจึงมีได้แถวเดียว
  @@unique([orgId, source, category, refType, refId], name: "performance_event_dedupe")
  @@index([orgId, userId, occurredAt])
  @@index([orgId, occurredAt])
  @@map("performance_events")
  @@schema("core")
}

// การตั้งค่าระบบคะแนนผลงาน — แยกตามบริษัท
//
// ทุกตัวเลขที่ใช้ตัดสินว่า "ผลงานดีหรือไม่ดี" ต้องตั้งได้เอง เพราะแต่ละบริษัท
// มีมาตรฐานคนละแบบ — บางที่สาย 5 นาทีถือว่าสาย บางที่ให้ผ่อนผัน 30 นาที
// ไม่มีแถว = ใช้ค่าเริ่มต้นในโค้ด (ดู apps/web/lib/performance.ts)
model PerformanceSetting {
  orgId String @id @map("org_id")

  /** เปิด/ปิดระบบคะแนนทั้งหมดของบริษัทนี้ */
  enabled Boolean @default(true)

  /** คะแนนตั้งต้นก่อนหัก */
  baseScore Int @default(100) @map("base_score")

  /** สายเกินกี่นาทีถึงเริ่มหัก — ต่ำกว่านี้ถือว่าอยู่ในวิสัยปกติ */
  lateThresholdMinutes Int @default(15) @map("late_threshold_minutes")

  /** ขาดงานเกินกี่นาทีถึงนับเป็นขาดงาน */
  absenceThresholdMinutes Int @default(240) @map("absence_threshold_minutes")

  /** PM เลยกำหนดกี่วันถึงถือว่าปล่อยปละละเลย (เผื่อเวลาให้ทำก่อน) */
  pmGraceDays Int @default(7) @map("pm_grace_days")

  /** ย้อนดูผลลงเวลากี่วันในแต่ละรอบ cron */
  attendanceLookbackDays Int @default(45) @map("attendance_lookback_days")

  /**
   * คะแนนต่อเหตุการณ์ — { "task_late": -3, ... } ทับค่าเริ่มต้นเฉพาะคีย์ที่ระบุ
   * เก็บเป็น JSON เพราะชนิดเหตุการณ์เพิ่มได้เรื่อย ๆ ตามโมดูลที่เสียบเข้ามา
   * ถ้าแตกเป็นคอลัมน์จะต้อง migrate ทุกครั้งที่เพิ่มเหตุการณ์ใหม่
   */
  rulePoints Json @default("{}") @map("rule_points")

  /** เกณฑ์เกรด — { "A": 90, "B": 80, "C": 70, "D": 60 } ต่ำกว่าตัวสุดท้าย = F */
  gradeThresholds Json @default("{}") @map("grade_thresholds")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("performance_settings")
  @@schema("core")
}

// ═══════════════════════════ report_task ═══════════════════════════
// โมดูลรายงานและงาน (พอร์ตจากแอป easyboss-workspace)
//
// ฝั่ง client เก็บสถานะที่แชร์กันทั้งทีมไว้ใน zustand store ~15 ตัว แล้วเขียนกลับ
// ผ่าน endpoint เดียว `/api/report-task/store/{key}` (กับ `/tasks` อีกตัว)
// ⇒ ฝั่งเซิร์ฟเวอร์จึงเก็บเป็น "ก้อน JSON ต่อคีย์ ต่อบริษัท" ก้อนเดียวจบ
//
// ทำไมไม่แตกเป็นตารางต่อ entity: รูปร่างข้อมูลยังเปลี่ยนบ่อยตามการพัฒนาฝั่ง
// workspace และสัญญาระหว่าง client กับ server คือ "ทั้งก้อน" อยู่แล้ว
// (โหลดทั้งก้อนตอน mount เขียนทั้งก้อนตอนเปลี่ยน) การแตกตารางตอนนี้จะได้
// ความซับซ้อนโดยไม่ได้ประโยชน์ — แตกทีหลังได้เมื่อ schema นิ่ง
//
// version = optimistic concurrency ป้องกันสองแท็บเขียนทับกัน (client ส่ง
// expectedVersion มา ไม่ตรงกัน = 409 ให้โหลดใหม่)
model ReportTaskStore {
  orgId     String   @map("org_id")
  key       String
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // ผู้ใช้คนล่าสุดที่เขียน — ไว้ไล่ย้อนตอนข้อมูลเพี้ยน

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("stores")
  @@schema("report_task")
}
