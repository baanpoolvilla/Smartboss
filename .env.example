# ── Database ────────────────────────────────────────────────────────────────
# local dev: ทั้งสองเส้นชี้ Postgres เดียวกัน (ไม่มี pooler)
# production (Neon): DATABASE_URL          = เส้น pooled (โฮสต์มี "-pooler") — app runtime ใช้
#                    DATABASE_URL_UNPOOLED = เส้น unpooled — prisma migrate/studio ใช้
# ชื่อตรงกับที่ Neon integration ของ Vercel inject ให้อัตโนมัติ อย่าเปลี่ยนชื่อ
DATABASE_URL=postgresql://easyboss:easyboss@localhost:5432/easyboss
DATABASE_URL_UNPOOLED=postgresql://easyboss:easyboss@localhost:5432/easyboss

# ── Redis (rate limit) ──────────────────────────────────────────────────────
# production: Upstash (rediss://...) — ถ้าไม่ตั้ง rate limit จะ fail-open
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false          # production ต้องเป็น true

# ── File storage ────────────────────────────────────────────────────────────
# ไม่ตั้ง = เขียนลง disk (.uploads) — ใช้ได้แค่ dev
# production **ต้องตั้ง** เพราะ Vercel เขียน filesystem ไม่ได้
# ใช้กับ S3-compatible ทุกตัว: Cloudflare R2 (แนะนำ — ไม่คิดค่า egress), AWS S3, MinIO
S3_BUCKET=
S3_ENDPOINT=              # R2: https://<account_id>.r2.cloudflarestorage.com (S3 แท้เว้นว่าง)
S3_REGION=auto            # R2 = auto · AWS = ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Cron (/api/cron/maintenance) ────────────────────────────────────────────
# production ต้องตั้ง ไม่งั้น endpoint เปิดให้ใครก็เรียกได้
CRON_SECRET=

# ── Seed (packages/database/seed.ts) ────────────────────────────────────────
# seed สร้างให้แค่ **บริษัทเดียว + ผู้ดูแลระบบสูงสุดคนเดียว** ไม่มีผู้ใช้ตัวอย่าง
# พนักงานจริงเพิ่มเองที่ /admin/users หลัง login
SEED_ORG_NAME=บริษัทของฉัน
SEED_ORG_SLUG=main
SEED_ADMIN_EMAIL=admin@smartboss.app
SEED_ADMIN_NAME=ผู้ดูแลระบบสูงสุด
# ต้องยาวอย่างน้อย 12 ตัว — เปลี่ยนทันทีหลัง login ครั้งแรกแล้วลบบรรทัดนี้ทิ้ง
SEED_ADMIN_PASSWORD=

# ── Discord Report Sync (ชั่วคราว) ──
# secret ที่ bot ใช้ยิงเข้า /api/report-task/discord-ingest — ต้องตรงกับใน discord-report-bot/.env
DISCORD_SYNC_SECRET=
