# Caddy — ตัวเดียวที่เปิดสู่อินเทอร์เน็ต
#
# ขอใบรับรอง Let's Encrypt และต่ออายุให้เองอัตโนมัติ ไม่ต้องมี cron ของ certbot
# เงื่อนไข: DNS ของทั้ง 3 ชื่อต้องชี้มาที่ IP ของ VM แล้ว **ก่อน** สตาร์ต
# ไม่งั้นการขอใบรับรองจะล้มซ้ำ ๆ จนโดน rate limit ของ Let's Encrypt (5 ครั้ง/ชม.)

{
	email {$ACME_EMAIL}
}

# ── เว็บ Smartboss ────────────────────────────────────────────────────────
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	# ที่อัปโหลดไฟล์แนบงานซ่อม — ค่าเริ่มต้นของ Caddy ไม่จำกัด แต่จำกัดไว้กัน abuse
	request_body {
		max_size 25MB
	}

	log {
		output file /data/log/app.log {
			roll_size 20MB
			roll_keep 10
		}
	}
}

# ── ด่านของเครื่องสแกนลายนิ้วมือ ─────────────────────────────────────────
#
# ESP32 ยิงเข้าตัวนี้เท่านั้น gateway ปล่อยผ่านเฉพาะ 6 path ที่เครื่องต้องใช้
# ที่เหลือตอบ 404 ⇒ เครื่องที่ถูกยึดไปแกะ ก็เข้าถึง endpoint ของ HR ไม่ได้
{$DEVICE_DOMAIN} {
	reverse_proxy 127.0.0.1:3200

	request_body {
		max_size 1MB
	}

	log {
		output file /data/log/device.log {
			roll_size 20MB
			roll_keep 10
		}
	}
}

# ── ไฟล์แนบ (MinIO) ──────────────────────────────────────────────────────
#
# เปิดสู่เน็ตแต่ **ไม่ได้เปิดโล่ง** — ทุก object ต้องมาพร้อม presigned URL ที่
# เซิร์ฟเวอร์เซ็นให้ อายุ 5 นาที ไม่มีลายเซ็น MinIO ตอบ 403 เอง
#
# ห้ามใส่ header_up Host — ลายเซ็น AWS SigV4 คิดรวมโฮสต์ไว้ด้วย
# แก้ Host เมื่อไหร่ ลายเซ็นเพี้ยนทันที (Caddy ส่ง Host เดิมต่อให้อยู่แล้ว)
{$FILES_DOMAIN} {
	reverse_proxy 127.0.0.1:9000

	request_body {
		max_size 25MB
	}
}
