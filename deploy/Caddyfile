# Caddy — ตัวเดียวที่เปิดสู่อินเทอร์เน็ต
#
# ขอใบรับรอง Let's Encrypt และต่ออายุให้เองอัตโนมัติ ไม่ต้องมี cron ของ certbot
# เงื่อนไข: DNS ของทั้ง 3 ชื่อต้องชี้มาที่ IP ของ VM แล้ว **ก่อน** สตาร์ต
# ไม่งั้นการขอใบรับรองจะล้มซ้ำ ๆ จนโดน rate limit ของ Let's Encrypt (5 ครั้ง/ชม.)
#
# ── ใส่ได้มากกว่าหนึ่งชื่อ ──
# ตัวแปรทั้งสามถูกแทนค่าก่อน Caddy จะ parse ⇒ ใส่หลายชื่อคั่นด้วยจุลภาคใน
# deploy/.env ได้เลย โดยไม่ต้องแก้ไฟล์นี้:
#
#   APP_DOMAIN=app.easyboss.app, app.smartboss.in.th
#
# ใช้ตอนย้ายโดเมน — ให้ชื่อเก่ากับชื่อใหม่ทำงานพร้อมกันจนกว่าจะ flash
# เครื่องสแกนครบทุกเครื่อง (ขั้นตอนเต็มอยู่ใน docs/deploy.md ข้อ 11.8)

{
	email {$ACME_EMAIL}
}

# ── หน้าแนะนำระบบ (เว็บขายของ) ────────────────────────────────────────────
#
# HTML ล้วน เสิร์ฟจากไฟล์ตรง ๆ ไม่ผ่าน Next
# ⇒ ตัวระบบล่มหรือกำลัง build อยู่ หน้านี้ก็ยังขึ้นปกติ และไม่กินแรมเพิ่มเลย
#
# ตั้ง WWW_DOMAIN ใน deploy/.env เป็น "smartboss.in.th, www.smartboss.in.th"
# ถ้าไม่ตั้ง บล็อกนี้จะไม่ทำงาน (Caddy ข้าม site ที่ไม่มีชื่อ)
{$WWW_DOMAIN} {
	encode zstd gzip
	root * /opt/smartboss/deploy/www
	file_server

	# กันไม่ให้หน้าเก่าค้างในเบราว์เซอร์นานหลังแก้ข้อความ
	header Cache-Control "public, max-age=300"

	log {
		output file /data/log/www.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ── เว็บ Smartboss ────────────────────────────────────────────────────────
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	# ที่อัปโหลดไฟล์แนบงานซ่อม — ค่าเริ่มต้นของ Caddy ไม่จำกัด แต่จำกัดไว้กัน abuse
	request_body {
		max_size 25MB
	}

	log {
		output file /data/log/app.log {
			roll_size 20MB
			roll_keep 10
		}
	}
}

# ── ด่านของเครื่องสแกนลายนิ้วมือ ─────────────────────────────────────────
#
# ESP32 ยิงเข้าตัวนี้เท่านั้น gateway ปล่อยผ่านเฉพาะ 6 path ที่เครื่องต้องใช้
# ที่เหลือตอบ 404 ⇒ เครื่องที่ถูกยึดไปแกะ ก็เข้าถึง endpoint ของ HR ไม่ได้
{$DEVICE_DOMAIN} {
	reverse_proxy 127.0.0.1:3200

	request_body {
		max_size 1MB
	}

	log {
		output file /data/log/device.log {
			roll_size 20MB
			roll_keep 10
		}
	}
}

# ── ไฟล์แนบ (MinIO) ──────────────────────────────────────────────────────
#
# เปิดสู่เน็ตแต่ **ไม่ได้เปิดโล่ง** — ทุก object ต้องมาพร้อม presigned URL ที่
# เซิร์ฟเวอร์เซ็นให้ อายุ 5 นาที ไม่มีลายเซ็น MinIO ตอบ 403 เอง
#
# ห้ามใส่ header_up Host — ลายเซ็น AWS SigV4 คิดรวมโฮสต์ไว้ด้วย
# แก้ Host เมื่อไหร่ ลายเซ็นเพี้ยนทันที (Caddy ส่ง Host เดิมต่อให้อยู่แล้ว)
{$FILES_DOMAIN} {
	reverse_proxy 127.0.0.1:9000

	request_body {
		max_size 25MB
	}
}
