# ตารางงานอัตโนมัติของ SmartBoss (crontab ของ user smartboss)
#
# release.sh ติดตั้งไฟล์นี้ให้เองทุกครั้งที่ deploy — แก้ตารางงานที่ไฟล์นี้ แล้ว deploy
# ไม่ต้อง crontab -e บนเครื่อง · ย้ายเครื่องแล้ว deploy ครั้งแรก ตารางงานก็มาเอง
# (ผู้ใช้ 3/11/2569 "เวลาย้ายเครื่องจะได้ไปด้วย ไม่ต้องมาติดตั้งแยก")
#
# งานที่ต้องใช้สิทธิ์ root (สำรองฐานข้อมูล) อยู่ที่ deploy/smartboss-root.cron — ติดตั้งครั้งเดียวตอนตั้งเครื่อง
#
# ดู log:  journalctl -t smartboss-cron --since today
# เวลาเป็นเวลาไทย (เครื่องตั้ง Asia/Bangkok ตาม docs/deploy.md)
SHELL=/bin/bash

# เปิดใบงานจาก PM ที่ถึงกำหนด (PM แบบนับรอบ: เปิดล่วงหน้าตามที่ตั้ง) — 08:00
0 8 * * * bash /opt/smartboss/deploy/cron-run.sh work-orders 2>&1 | systemd-cat -t smartboss-cron
# เตือน PM / ใบงานใกล้ครบกำหนดและเลยกำหนด (เฉพาะผู้รับผิดชอบ) — 08:05
5 8 * * * bash /opt/smartboss/deploy/cron-run.sh pm-notify 2>&1 | systemd-cat -t smartboss-cron

# หักคะแนนใบงาน PM และค่าใช้จ่ายทันทีที่หมดวันครบกำหนด ทุกวัน 00:05 (ผู้ใช้ 4/11/2569 "ทำไมต้องรอ 5 โมง") — ลงเวลา รายงาน งานบนบอร์ดไม่อยู่ในงานนี้ ยังหักตามเดิม (ผู้ใช้ 4/11/2569)
5 0 * * * bash /opt/smartboss/deploy/cron-run.sh maintenance-score 2>&1 | systemd-cat -t smartboss-cron

# เด้งเวลาเข้า/ออกงานเข้าห้อง "🕐 ระบบลงเวลา" ของแต่ละคน + กระดิ่ง/แจ้งเตือน — ทุกนาที (ไม่มีอะไรใหม่ = จบเร็ว)
# รอบเดียวกันเช็กเตือนใกล้ถึงกำหนด งาน/ประชุม/รีพอต · ไม่หักคะแนนใด ๆ (ผู้ใช้ 5/11/2569 "ระบบลงเวลาไม่ขึ้นและไม่แจ้งเตือน")
# ย้อนดูแค่ 3 ชม. ⇒ เปิดแล้วไม่เทรายการเก่าที่ตกหล่นเข้าแชท
* * * * * bash /opt/smartboss/deploy/cron-run.sh attendance-chat 2>&1 | systemd-cat -t smartboss-cron

# Google Ads Report — ซิงค์ทุกเช้า 06:00 · สรุปวันจันทร์ 07:00 · รอบครึ่งเดือนวันที่ 1 และ 16
# เดิมใส่ crontab บนเครื่อง GCE ด้วยมือ ⇒ ย้ายไป DigitalOcean แล้วหายไปเงียบ ๆ ซิงค์ค้างที่ 30/10/2569 (พบ 9/11/2569)
0 6 * * * bash /opt/smartboss/deploy/cron-run.sh sync ads 2>&1 | systemd-cat -t smartboss-cron
0 7 * * 1 bash /opt/smartboss/deploy/cron-run.sh weekly ads 2>&1 | systemd-cat -t smartboss-cron
0 7 1,16 * * bash /opt/smartboss/deploy/cron-run.sh half-month ads 2>&1 | systemd-cat -t smartboss-cron

# ── รอบถัดไป: ยังไม่เปิด (3/11/2569 คุยกันก่อน) — ลบ # หน้าบรรทัดแล้ว deploy เพื่อเปิด ──
# งานประจำวันที่เหลือ (เตือนค่าใช้จ่าย, แจ้งมาสาย, วันหยุด, OT รออนุมัติ, เตือนโปรเจกต์ ฯลฯ)
#   ⚠ "all" รวมการลบรูป/วิดีโอในแชทที่หมดอายุด้วย — ลองดูก่อน: bash deploy/cron-run.sh "chat-media&dryRun=1"
#   ⚠ "all" รวม work-orders กับ pm-notify ด้วย — เปิดบรรทัดนี้แล้วให้ปิดสองบรรทัดบน ไม่งั้นรันซ้ำ
# 0 8 * * * bash /opt/smartboss/deploy/cron-run.sh all 2>&1 | systemd-cat -t smartboss-cron
# */5 7-12 * * * bash /opt/smartboss/deploy/cron-run.sh late-alerts 2>&1 | systemd-cat -t smartboss-cron
# 0 17 * * * bash /opt/smartboss/deploy/cron-run.sh performance 2>&1 | systemd-cat -t smartboss-cron
# 59 * * * * bash /opt/smartboss/deploy/cron-run.sh score-hourly 2>&1 | systemd-cat -t smartboss-cron
# 5 0 * * * bash /opt/smartboss/deploy/cron-run.sh score-final 2>&1 | systemd-cat -t smartboss-cron
