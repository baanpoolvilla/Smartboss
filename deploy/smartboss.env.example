# ค่าตั้งของ Smartboss บน production — คัดลอกไปเป็น /etc/smartboss/smartboss.env
#
#   sudo install -d -m 700 /etc/smartboss
#   sudo cp deploy/smartboss.env.example /etc/smartboss/smartboss.env
#   sudo chmod 600 /etc/smartboss/smartboss.env
#   sudo nano /etc/smartboss/smartboss.env
#
# ไฟล์นี้ถูกอ่านโดย systemd (EnvironmentFile=) ⇒ **รูปแบบไม่ใช่ shell script**
#   ✗ ห้ามใส่คอมเมนต์ท้ายบรรทัดเดียวกับค่า   FOO=bar   # แบบนี้ "# แบบนี้" จะติดไปในค่า
#   ✗ ห้ามใช้ $OTHER_VAR — systemd ไม่ขยายตัวแปรให้
#   ✗ ห้ามใส่เครื่องหมายคำพูดถ้าไม่จำเป็น
#
# ทั้ง 4 โปรเซสใช้ไฟล์เดียวกัน ค่าที่ชื่อคนละอย่างแต่ต้องตรงกันถูกทำเครื่องหมาย ⚠ ไว้

# ══════════════════════════════════════════════════════════════════════════
#  1. ฐานข้อมูล
# ══════════════════════════════════════════════════════════════════════════
# Postgres อยู่ในคอนเทนเนอร์บนเครื่องเดียวกัน คุยผ่าน loopback ไม่ออกจากตัวเครื่อง
#
# sslmode=disable ใส่ไว้โดยตั้งใจ: workforce-api บังคับว่า production ต้องมี
# DATABASE_SSL หรือ sslmode ใน URL (schema.ts) กฎนั้นมีไว้กันข้อมูลวิ่งเปล่า ๆ
# ข้ามเครือข่าย — บน loopback ไม่มีเครือข่ายให้ดัก การเปิด TLS จึงไม่ได้อะไรเพิ่ม
# ⚠ วันไหนย้าย Postgres ไปคนละเครื่อง (Neon/Cloud SQL) ต้องเปลี่ยนเป็น sslmode=require ทันที
DATABASE_URL=postgresql://smartboss:CHANGE_ME@127.0.0.1:5432/smartboss?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://smartboss:CHANGE_ME@127.0.0.1:5432/smartboss?sslmode=disable
DATABASE_SSL=false

# ══════════════════════════════════════════════════════════════════════════
#  2. Redis (โควตาการเรียก / rate limit)
# ══════════════════════════════════════════════════════════════════════════
# ไม่ตั้ง = rate limit จะ fail-open (ปล่อยผ่านหมด) — production ควรตั้ง
REDIS_URL=redis://127.0.0.1:6379

# ══════════════════════════════════════════════════════════════════════════
#  3. ความลับ — สร้างด้วย deploy/gen-secrets.sh
# ══════════════════════════════════════════════════════════════════════════
# ⚠ JWT_SECRET และ AUTH_SMARTBOSS_SECRET ต้องเป็นค่า "เดียวกัน"
#   ไม่ตรงกัน = login เว็บได้ แต่ทุกหน้า HR ขึ้น 401 โดยไม่บอกสาเหตุ
JWT_SECRET=
AUTH_SMARTBOSS_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=true

# ⚠ ใช้เข้ารหัสเลขบัตรประชาชน / เลขบัญชีธนาคาร — base64 ของ 32 ไบต์พอดี
#   หายเมื่อไหร่ข้อมูลที่เข้ารหัสไว้กู้ไม่ได้เลย สำรองแยกจาก backup ฐานข้อมูล
FIELD_ENCRYPTION_KEY=

# กัน /api/cron/maintenance ถูกเรียกจากข้างนอก
CRON_SECRET=

# ══════════════════════════════════════════════════════════════════════════
#  4. โดเมน
# ══════════════════════════════════════════════════════════════════════════
# ⚠ ต้องมี /api/workforce/v1 ต่อท้าย ไม่ใช่ origin เปล่า
#   เว็บกับ API อยู่เครื่องเดียวกัน จึงเรียกผ่าน loopback — API ไม่ต้องเปิดสู่เน็ตเลย
WORKFORCE_API_BASE=http://127.0.0.1:4100/api/workforce/v1

# ══════════════════════════════════════════════════════════════════════════
#  5. ที่เก็บไฟล์ (MinIO บนเครื่องเดียวกัน)
# ══════════════════════════════════════════════════════════════════════════
# ⚠ endpoint ต้องเป็นโดเมนสาธารณะ ไม่ใช่ 127.0.0.1
#   เพราะเบราว์เซอร์ของผู้ใช้เป็นคนเปิด presigned URL ที่เซ็นจากโฮสต์นี้
#
# ชื่อ S3_* = ฝั่งเว็บ (โมดูลแจ้งซ่อม) · ชื่อ STORAGE_* = ฝั่ง workforce-api
# คนละชื่อแต่ต้องชี้ที่เดียวกัน
S3_BUCKET=smartboss
S3_ENDPOINT=https://files.example.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STORAGE_DRIVER=s3
STORAGE_BUCKET=smartboss
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://files.example.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ══════════════════════════════════════════════════════════════════════════
#  6. workforce-api / worker / gateway
# ══════════════════════════════════════════════════════════════════════════
NODE_ENV=production
LOG_LEVEL=info

HTTP_HOST=127.0.0.1
HTTP_PORT=4100
# ไม่มีเบราว์เซอร์ยิงข้ามโดเมนมาที่ API (เว็บเรียกจากฝั่งเซิร์ฟเวอร์) แต่ schema
# ห้าม "*" ใน production จึงใส่โดเมนเว็บไว้
CORS_ALLOWED_ORIGINS=https://app.example.com

AUTH_PROVIDER=smartboss
AUTH_ISSUER=smartboss
AUTH_AUDIENCE=smartboss-web
AUTH_TENANT_CLAIM=orgId

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3200
GATEWAY_UPSTREAM=http://127.0.0.1:4100
# โควตาต่อเครื่องสแกนต่อนาที — เครื่องปกติใช้ไม่ถึง 10
GATEWAY_RATE_LIMIT=120

DEFAULT_TIME_ZONE=Asia/Bangkok
DEFAULT_CURRENCY=THB

# ══════════════════════════════════════════════════════════════════════════
#  7. ข้อมูลตั้งต้น (ใช้ตอน seed ครั้งแรกเท่านั้น)
# ══════════════════════════════════════════════════════════════════════════
# seed สร้างให้แค่ **บริษัทเดียว + ผู้ดูแลระบบสูงสุดคนเดียว**
# ไม่มีผู้ใช้ตัวอย่าง ไม่มีข้อมูลทดสอบ — พนักงานจริงเพิ่มเองที่ /admin/users
SEED_ORG_NAME=บริษัทของฉัน
SEED_ORG_SLUG=main
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=ผู้ดูแลระบบสูงสุด
# ยาวอย่างน้อย 12 ตัว · เปลี่ยนในเว็บทันทีหลัง login แล้ว **ลบ 5 บรรทัดนี้ทิ้ง**
SEED_ADMIN_PASSWORD=
